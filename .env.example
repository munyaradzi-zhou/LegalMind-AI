# =============================================================================
# LegalMind AI — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Azure Tenant & Subscription
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-legalmind-dev
# Entra ID token audience for API auth in production (app registration client ID or api://... URI)
AZURE_API_AUDIENCE=

# LLM provider: "auto" (OpenAI API if OPENAI_API_KEY is set, else Azure OpenAI),
# "openai" (OpenAI API with the key below) or "azure" (Azure OpenAI, keyless via Entra ID)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Azure AI Foundry / OpenAI (used when LLM_PROVIDER resolves to "azure")
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-resource>.search.windows.net
AZURE_SEARCH_INDEX_NAME=legalmind-legal-docs

# Azure Content Understanding
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/

# Azure AI Language
AZURE_LANGUAGE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/

# Azure Translator
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_REGION=westeurope

# Azure AI Content Safety
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_SEVERITY_THRESHOLD=4
AZURE_CONTENT_SAFETY_ENABLE_PII_DETECTION=true

# Azure Cosmos DB
AZURE_COSMOS_ENDPOINT=https://<your-resource>.documents.azure.com:443/
AZURE_COSMOS_DATABASE=legalmind
AZURE_COSMOS_CONTAINER_SESSIONS=sessions
AZURE_COSMOS_CONTAINER_MEMORY=memory
AZURE_COSMOS_CONTAINER_AUDIT=audit_log

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_URL=https://<your-resource>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=legal-documents

# Azure Key Vault
AZURE_KEYVAULT_URL=https://<your-resource>.vault.azure.net/

# Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Application Settings
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:8501"]

# LLM query rewriting before search (adds ~1.3 s; no gain measured on the sample corpus)
QUERY_REWRITING_ENABLED=false
