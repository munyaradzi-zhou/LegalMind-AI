server {
    listen 8080;
    root /usr/share/nginx/html;

    # Only the API, Microsoft sign-in and the fonts; no inline scripts from anywhere else
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' ${WEB_API_URL} https://login.microsoftonline.com; frame-src https://login.microsoftonline.com; img-src 'self' data:; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /config.json {
        alias /tmp/config.json;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'" always;
    }

    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ $uri.html /index.html;
    }
}
